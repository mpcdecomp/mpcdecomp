OBJDIR =
CC = cc
CFLAGS = -O2 -w
LD = cc
LDFLAGS =
LDLIBS =
HOST_OBJEXTENSION = .o
HOST_EXEXTENSION =
TARG_OBJDIR = $(OBJDIR)
TARG_CC = $(CC)
TARG_CFLAGS = $(CFLAGS)
TARG_LD = $(LD)
TARG_LDFLAGS = $(LDFLAGS)
TARG_OBJEXTENSION = $(HOST_OBJEXTENSION)
TARG_EXEXTENSION = $(HOST_EXEXTENSION)
BINDIR = $(CURDIR)
INCDIR = $(BINDIR)/include
MANDIR = $(BINDIR)/man
LIBDIR = $(BINDIR)/lib
DOCDIR = $(BINDIR)/doc
