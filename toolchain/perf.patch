 /*------------------------------------------------------------------------*/
+
+/* Forward-label drift.  A label not yet defined in this pass is looked up at
+   its value from the last one, which is stale by however far the code ahead
+   of it has moved since (a jmp that was short last pass is near now).  A
+   short/near choice made against it is a pass behind, so a chain of them
+   settles one link per pass.  The PC at every source position is recorded
+   instead, and a forward label is looked up at its old value plus how far the
+   current position has moved since the last pass.
+
+   A position is a (file, line) pair, recorded when it changes: the lines of a
+   macro, REPT or IRP expansion carry the line of the statement that expanded
+   them, so an expansion whose length depends on a value (rept target-$) is one
+   position and does not shift the ones after it.  A position whose line is not
+   the last pass's at the same index gives no drift.
+
+   An estimate is marked questionable and forces another pass, so a pass that
+   used one is never the last: the output is still that of a pass in which no
+   forward label moved.  It only shortens the way there. */
+
+typedef struct { LargeWord pc; LongInt line; Byte seg; } fwd_pos_t;
+static fwd_pos_t *fwd_prev, *fwd_cur;
+static size_t fwd_n_prev, fwd_n_cur, fwd_cap_prev, fwd_cap_cur;
+static LongInt fwd_last_line;
+static String fwd_last_file;
+
+static void fwd_pc_newpass(void)
+{
+  fwd_pos_t *p = fwd_prev; size_t c = fwd_cap_prev;
+
+  fwd_prev = fwd_cur; fwd_cap_prev = fwd_cap_cur; fwd_n_prev = fwd_n_cur;
+  fwd_cur = p; fwd_cap_cur = c; fwd_n_cur = 0;
+  fwd_last_line = -1;
+  *fwd_last_file = '\0';
+}
+
+static void fwd_pc_line(void)
+{
+  if ((CurrLine == fwd_last_line) && !strcmp(CurrFileName, fwd_last_file))
+    return;
+  fwd_last_line = CurrLine;
+  strmaxcpy(fwd_last_file, CurrFileName, STRINGSIZE);
+  if (fwd_n_cur >= fwd_cap_cur)
+  {
+    fwd_cap_cur = fwd_cap_cur ? 2 * fwd_cap_cur : 65536;
+    fwd_cur = (fwd_pos_t*)realloc(fwd_cur, fwd_cap_cur * sizeof(*fwd_cur));
+  }
+  fwd_cur[fwd_n_cur].pc = EProgCounter();
+  fwd_cur[fwd_n_cur].line = CurrLine;
+  fwd_cur[fwd_n_cur].seg = ActPC;
+  fwd_n_cur++;
+}
+
+LargeInt fwd_label_drift(unsigned addrspace_mask)
+{
+  const fwd_pos_t *p_cur, *p_prev;
 
+  if (!fwd_n_cur || (fwd_n_cur > fwd_n_prev) || (addrspace_mask != (1u << ActPC)))
+    return 0;
+  p_cur = &fwd_cur[fwd_n_cur - 1];
+  p_prev = &fwd_prev[fwd_n_cur - 1];
+  if ((p_cur->line != p_prev->line) || (p_cur->seg != ActPC) || (p_prev->seg != ActPC))
+    return 0;
+  return (LargeInt)p_cur->pc - (LargeInt)p_prev->pc;
+}
